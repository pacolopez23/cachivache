<!--
    Panel de INICIO de la ventana principal.

    NO ES UN DOCUMENTO XAML COMPLETO: es un TROZO de MainWindow.xaml,
    que lo inserta en su sitio antes de interpretar el XAML entero.
    Por eso no declara xmlns ni tiene un único elemento raiz propio:
    los hereda del documento donde se pega.

    Se hace así, y no cargando cada panel por separado, para que
    siga habiendo UN SOLO arbol y UN SOLO ámbito de nombres. Con
    paneles cargados aparte, $ventana.FindName() dejaria de
    encontrar sus controles -viven en otro ámbito- y habría que
    rehacer la resolución entera de la ventana. Aquí no cambia nada
    en tiempo de ejecución: el XAML que se interpreta es identico,
    byte a byte, al de antes de partirlo.
-->
                    <!-- ==================== INICIO ==================== -->
                    <!--
                        Focusable + IsTabStop="False": el panel es DESTINO de
                        foco pero no PARADA de tabulacion.

                        Cambiar de panel solo alternaba la visibilidad, asi que
                        para un lector de pantalla no pasaba nada: el foco se
                        quedaba en el boton de la barra lateral y el contenido
                        cambiaba en silencio. Ahora mostrarPanel le da el foco
                        al panel entero, y al hacerlo el lector anuncia su
                        nombre -que es su titulo visible-.

                        Las dos propiedades van juntas a proposito: Focusable
                        solo, sin IsTabStop="False", anyade seis paradas nuevas
                        de tabulacion que un usuario de teclado con vista
                        tendria que atravesar cada vez. Focus() por codigo
                        funciona igual. Ver [A11Y-06].
                    -->
                    <Grid x:Name="PanelInicio"
                          Focusable="True" KeyboardNavigation.IsTabStop="False"
                          AutomationProperties.Name="Análisis del equipo">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="32,28,32,0">
                            <TextBlock Text="Análisis del equipo" Style="{StaticResource Titulo}"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Margin="0,4,0,0"
                                       Text="Elige un perfil y los módulos que quieres revisar. El análisis no borra nada: solo mira y te enseña lo que ha encontrado."/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="32,24,24,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,20">

                                <!-- Perfiles -->
                                <TextBlock Text="PERFIL DE LIMPIEZA" Style="{StaticResource Seccion}"/>
                                <ItemsControl x:Name="ListaPerfiles">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--
                                                Este RadioButton reemplaza su plantilla ENTERA y
                                                no deja ningun ContentPresenter dentro, asi que
                                                su Content esta vacio: los TextBlock del nombre y
                                                el resumen los pinta la plantilla. Para un lector
                                                de pantalla eso son cuatro botones de opcion sin
                                                nombre, y elegir perfil es la primera decision
                                                del programa. Se enlaza a la MISMA propiedad que
                                                pinta el titulo, para que no puedan separarse.
                                                Ver [A11Y-01].
                                            -->
                                            <RadioButton GroupName="perfil" Cursor="Hand" Margin="0,0,12,0"
                                                         AutomationProperties.Name="{Binding Nombre}"
                                                         IsChecked="{Binding Activo, Mode=TwoWay}">
                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="marco" CornerRadius="11" Padding="16"
                                                                Background="{DynamicResource FondoTarjeta}"
                                                                BorderBrush="{DynamicResource Borde}" BorderThickness="1.5">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="15"/>
                                                                <TextBlock Text="{Binding Resumen}" FontSize="12" Margin="0,4,0,0"
                                                                           TextWrapping="Wrap" Height="46"
                                                                           Foreground="{DynamicResource TextoTenue}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="marco" Property="Background" Value="{DynamicResource FondoElevado}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="marco" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                                                <Setter TargetName="marco" Property="Background"  Value="{DynamicResource AcentoTenue}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Módulos -->
                                <Grid Margin="0,30,0,0">
                                    <TextBlock Text="MÓDULOS A ANALIZAR" Style="{StaticResource Seccion}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,0,0">
                                        <Button x:Name="BtnModulosTodos"  Style="{StaticResource BotonTexto}" Content="Marcar todos"/>
                                        <Button x:Name="BtnModulosNinguno" Style="{StaticResource BotonTexto}" Content="Desmarcar todos"/>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl x:Name="ListaModulos">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,12,12" Padding="16">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Disponible}" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!--
                                                        La casilla esta en una celda y el nombre del
                                                        modulo en otra: para WPF no hay relacion entre
                                                        las dos, asi que sin nombre propio son
                                                        veintiuna casillas identicas. Mismo enlace que
                                                        el TextBlock de al lado. Ver [A11Y-01].
                                                    -->
                                                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"
                                                              AutomationProperties.Name="{Binding Nombre}"
                                                              IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                                              IsEnabled="{Binding Disponible}"/>

                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13"
                                                                       TextWrapping="Wrap" MaxWidth="280"/>
                                                            <StackPanel Orientation="Horizontal" Margin="10,2,0,0"
                                                                        VerticalAlignment="Top">
                                                                <Ellipse Style="{StaticResource Punto}" Fill="{Binding ColorRiesgo}"/>
                                                                <TextBlock Style="{StaticResource TextoEtiqueta}"
                                                                           Text="{Binding Riesgo}" Foreground="{Binding ColorRiesgo}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Descripcion}" FontSize="12" Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextoTenue}"/>
                                                        <TextBlock Text="{Binding Nota}" FontSize="12" Margin="0,4,0,0"
                                                                   TextWrapping="Wrap" Visibility="{Binding VisibilidadNota}"
                                                                   Foreground="{DynamicResource Aviso}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pie de acción -->
                        <Border Grid.Row="2" Background="{DynamicResource FondoBarra}"
                                BorderBrush="{DynamicResource Borde}" BorderThickness="0,1,0,0" Padding="32,16">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtEstadoInicio" FontSize="13" Text="Listo para analizar."/>
                                    <ProgressBar x:Name="BarraInicio" Width="420" Margin="0,12,0,0"
                                                 HorizontalAlignment="Left" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnCancelar" Style="{StaticResource BotonSecundario}"
                                            Content="Cancelar" Margin="0,0,10,0" Visibility="Collapsed"/>
                                    <Button x:Name="BtnAnalizar" Style="{StaticResource BotonPrimario}"
                                            Content="Analizar el equipo" Padding="24,12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>


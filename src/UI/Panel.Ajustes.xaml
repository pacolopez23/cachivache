<!--
    Panel de AJUSTES de la ventana principal.

    NO ES UN DOCUMENTO XAML COMPLETO: es un TROZO de MainWindow.xaml,
    que lo inserta en su sitio antes de interpretar el XAML entero.
    Por eso no declara xmlns ni tiene un único elemento raiz propio:
    los hereda del documento donde se pega.

    Se hace así, y no cargando cada panel por separado, para que
    siga habiendo UN SOLO arbol y UN SOLO ámbito de nombres. Con
    paneles cargados aparte, $ventana.FindName() dejaria de
    encontrar sus controles -viven en otro ámbito- y habría que
    rehacer la resolución entera de la ventana. Aquí no cambia nada
    en tiempo de ejecución: el XAML que se interpreta es identico,
    byte a byte, al de antes de partirlo.
-->
                    <!-- ==================== AJUSTES ==================== -->
                    <!-- Destino de foco, no parada de tabulacion. Ver [A11Y-06]. -->
                    <Grid x:Name="PanelAjustes" Visibility="Collapsed"
                          Focusable="True" KeyboardNavigation.IsTabStop="False"
                          AutomationProperties.Name="Ajustes">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="32,28,32,0">
                            <TextBlock Text="Ajustes" Style="{StaticResource Titulo}"/>
                            <TextBlock Style="{StaticResource Subtitulo}" Margin="0,4,0,0"
                                       Text="Estos valores se aplican al análisis y se recuerdan entre sesiones. Al tocar cualquiera, el perfil pasa a Personalizado."/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="32,24,24,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,8,24" MaxWidth="720" HorizontalAlignment="Left">

                                <Border Style="{StaticResource Tarjeta}">
                                    <StackPanel>
                                        <TextBlock Text="Umbrales de detección" FontWeight="SemiBold" FontSize="15"/>

                                        <!-- Dos columnas: ver el comentario de la barra de abajo de
                                             Panel.Resultados.xaml. El deslizador mide 260 px fijos y
                                             el rotulo crece con el idioma; sin columnas se cruzan. -->
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Tamano mínimo para proponer un elemento"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TxtMinimoMB" Style="{StaticResource Subtitulo}" Text="10 MB"/>
                                            </StackPanel>
                                            <!--
                                                Los dos deslizadores estan en un Grid, a la derecha
                                                de su rotulo pero SIN relacion declarada con el:
                                                para WPF son dos hermanos en la misma celda. Sin
                                                nombre propio, un lector de pantalla anuncia
                                                "control deslizante, 10" y el usuario no sabe si
                                                son megabytes o dias. Ver [A11Y-01].
                                            -->
                                            <Slider x:Name="SliderMinimoMB" Grid.Column="1" Width="260" Minimum="1" Maximum="500"
                                                    AutomationProperties.Name="Tamaño mínimo en megabytes"
                                                    Value="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Style="{StaticResource Separador}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Días sin usar para considerar algo abandonado"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TxtDiasSinUso" Style="{StaticResource Subtitulo}" Text="180 días"/>
                                            </StackPanel>
                                            <Slider x:Name="SliderDias" Grid.Column="1" Width="260" Minimum="30" Maximum="730"
                                                    AutomationProperties.Name="Días sin usar"
                                                    Value="180" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Border Style="{StaticResource Separador}"/>

                                        <CheckBox x:Name="ChkMenores" Content="Incluir también los elementos pequeños"/>
                                        <TextBlock Style="{StaticResource Subtitulo}" Margin="28,4,0,0"
                                                   Text="Añade cachés de menos de unos pocos MB. Encuentra más cosas, pero la lista se llena de ruido."/>
                                    </StackPanel>
                                </Border>

                                <!--
                                    LO QUE NO SE TOCA NUNCA. La tarjeta que [CNF-01]
                                    daba por hecha en su banner y nunca se llego a
                                    hacer. Desde [USO-06] se podian anyadir
                                    exclusiones desde el menu contextual de la tabla,
                                    pero no quitarlas: la unica marcha atras era
                                    editar preferencias.json a mano.

                                    NO SE LLAMA "Carpetas que nunca se tocan", que es
                                    como la nombraba aquel banner, porque desde
                                    [ARQ-03] la lista guarda tambien claves
                                    sinteticas de cosas que no son carpetas -un
                                    comando del sistema, la papelera-. Una tarjeta
                                    titulada "Carpetas" con "Cache de Docker" dentro
                                    seria el programa etiquetando mal sus propios
                                    datos.

                                    AQUI NO DECIDE NADA EL XAML. El rotulo de arriba
                                    y los dos textos de cada fila salen de
                                    Get-ExclusionVista y Get-TextoListaExclusiones,
                                    en src/Core/Exclusiones.ps1, que son calculo puro
                                    y estan probados. Ni un DataTrigger, ni un Style
                                    con disparadores, ni un convertidor: en [USO-04]
                                    un disparador se aplico y su valor por defecto
                                    no, en Windows, y no se pudo averiguar por que.
                                    Sin WPF con el que comprobarlo, un mecanismo de
                                    XAML que no se puede verificar no tiene sitio
                                    aqui. Hay una prueba que lo prohibe sobre este
                                    bloque.

                                    El boton "Quitar" vive dentro de la plantilla,
                                    asi que no tiene ambito de nombres propio y
                                    FindName no lo encuentra: el Click se engancha en
                                    la lista y se mira quien lo disparo, igual que
                                    los botones de la cabecera de grupo de [USO-04].
                                    Lleva en el Tag la CLAVE EXACTA, no el titulo:
                                    quitar por el titulo no encontraria nada que
                                    quitar en cuanto la clave fuera sintetica.

                                    El rotulo del resumen se ve SIEMPRE, tambien con
                                    la lista vacia, y entonces dice donde esta la
                                    orden que la llena. Es la leccion de [USO-09]: un
                                    hueco en blanco se lee como un programa roto.
                                -->
                                <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Lo que no se toca nunca" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="TxtResumenExclusiones" Style="{StaticResource Subtitulo}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Todavía no has excluido nada."/>
                                        <ItemsControl x:Name="ListaExclusiones" Margin="0,14,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--
                                                        Fondo elevado y radio 6, que es el de las
                                                        filas. Con el estilo Tarjeta la fila
                                                        quedaria del mismo color que la tarjeta que
                                                        la contiene y solo la separaria una linea.
                                                    -->
                                                    <Border Background="{DynamicResource FondoElevado}"
                                                            BorderBrush="{DynamicResource Borde}" BorderThickness="1"
                                                            CornerRadius="6" Padding="13" Margin="0,0,0,7">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detalle}" FontSize="12" Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextoTenue}"/>
                                                            </StackPanel>
                                                            <Button x:Name="BtnQuitarExclusion" Grid.Column="1"
                                                                    Style="{StaticResource BotonSecundario}"
                                                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                                                    Content="Quitar" Tag="{Binding Clave}"
                                                                    AutomationProperties.Name="{Binding Titulo}"
                                                                    ToolTip="Deja de excluirlo. No borra nada: vuelve a proponerse en los próximos análisis."/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Como se elimina" FontWeight="SemiBold" FontSize="15"/>
                                        <CheckBox x:Name="ChkPermanente" Margin="0,16,0,0"
                                                  Content="Borrado permanente, sin pasar por la papelera"/>
                                        <TextBlock Style="{StaticResource Subtitulo}" Margin="28,6,0,0"
                                                   Text="Desactivado, todo lo que se pueda va a la papelera y se puede recuperar. Activado, el espacio se libera al instante pero no hay marcha atras."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Permisos" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="TxtEstadoAdmin" Style="{StaticResource Subtitulo}" Margin="0,8,0,16"
                                                   Text="Comprobando..."/>
                                        <Button x:Name="BtnReiniciarAdmin" Style="{StaticResource BotonSecundario}"
                                                Content="Reiniciar como administrador" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Datos del programa" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock x:Name="TxtCarpetaDatos" Style="{StaticResource Subtitulo}" Margin="0,8,0,16"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnAbrirDatos" Style="{StaticResource BotonSecundario}"
                                                    Content="Abrir carpeta de datos"/>
                                            <Button x:Name="BtnRestablecer" Style="{StaticResource BotonTexto}"
                                                    Content="Restablecer ajustes" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>


root = true

# Finales de linea: LF, en todo.
#
# Esto decia crlf y el repositorio entero esta en lf: se contradecian, y
# ganaba el disco. No es una preferencia estetica: hay una prueba que
# compara el XAML montado BYTE A BYTE con un oraculo guardado, asi que un
# editor que obedeciera a este archivo y guardara con CRLF la tumbaria sin
# tocar una sola linea de codigo, y el mensaje de error no hablaria de
# finales de linea. .gitattributes fija lo mismo del lado de Git, y
# core.autocrlf=input ya no convierte al sacar los archivos.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,psd1,psm1}]
indent_size = 4
max_line_length = 100

[*.xaml]
indent_size = 4

[*.{md,yml,yaml}]
indent_size = 2
trim_trailing_whitespace = false

[*.bat]
end_of_line = lf
